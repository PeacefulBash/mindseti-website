# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for sitemap, canonical and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown on the site. Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# International format, digits only, e.g. 26876000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Enquiry form delivery through Resend (server-side only)
RESEND_API_KEY=
PROPOSAL_TO_EMAIL=
PROPOSAL_FROM_EMAIL=
